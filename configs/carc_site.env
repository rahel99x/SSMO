# Project-specific CARC settings. This is sourced by scripts/carc.sh.
# Keep this file inside /home1/aadaniel/projects/SSNO. No Conda is used.
# Copy to local/carc_site.env for your site settings; the frontend prefers that
# ignored file automatically, so Git updates leave your settings intact.
# Environment overrides are supported without editing the checked-in defaults.
: "${SSMO_PYTHON_MODULE:=python/3.12.8}"
: "${SSMO_GPU_PROFILE:=a10040}"
: "${SSMO_MAX_PROJECT_JOBS:=10}"

# Fill all four values only after reviewing current shared-account policy,
# quota and running/pending jobs. These are FREE headroom, not account limits.
# The frontend never guesses these values from total cluster/node capacity.
# Fresh discovery and the low-level wrapper recheck policy before each submit.
: "${SSMO_ACCOUNT_SLOTS:=}"
: "${SSMO_ACCOUNT_FREE_CPUS:=}"
: "${SSMO_ACCOUNT_FREE_MEM_GB:=}"
: "${SSMO_ACCOUNT_FREE_GPUS:=}"
